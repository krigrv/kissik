<?xml version="1.0" encoding="utf-8" ?>
<!--
    OpenKamera main window — "Darkroom Glass" (approved 2026-11-02, design-demos/C - Darkroom Glass).
    Live video fills the window; every control floats over it on glass panels.
-->
<Page
    x:Class="OpenKamera_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:OpenKamera.Core"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
      <ResourceDictionary>
        <!-- Accent everywhere WinUI uses the system accent (toggles, sliders, selection, tab underline).
             Control templates look these up as ThemeResources, so they must live in theme dictionaries. -->
        
        <x:Double x:Key="ProgressBarTrackHeight">6</x:Double>
        <x:Double x:Key="ProgressBarMinHeight">6</x:Double>

        <!-- Design tokens -->
        <Color x:Key="DgAccent">#FFFFD36B</Color>
        <Color x:Key="DgRec">#FFD32F26</Color>
        <SolidColorBrush x:Key="DgRecBrush" Color="#FFD32F26" />



        <!-- Target size: every control at least 40 x 40 unless its own style says more. -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="MinHeight" Value="40" /><Setter Property="MinWidth" Value="40" /></Style>
        <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}"><Setter Property="MinHeight" Value="40" /><Setter Property="MinWidth" Value="40" /></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="MinHeight" Value="40" /></Style>
        <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}"><Setter Property="MinHeight" Value="40" /></Style>

        <Style x:Key="Glass" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="SectionValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CapsuleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="WellButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <!-- Picture tile (Background modes): selected = accent outline. -->
        <Style x:Key="Tile" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Height" Value="64" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
      </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <!-- ═══ Full-bleed stage ═══ -->
        <!-- The video sits between the panels (never under them) and is shown whole. Margins follow the panels. -->
        <Viewbox x:Name="StageViewbox" Stretch="Uniform" Margin="340,60,260,142">
            <Grid x:Name="Stage" Width="1280" Height="720" Background="Black">
                <Image x:Name="PreviewImage" Stretch="Fill" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform x:Name="PreviewFlip" /></Image.RenderTransform></Image>
                <!-- Scene layers: rendered from the scene document; captured into recordings. -->
                <Canvas x:Name="OverlayCanvas" Background="Transparent"
                        PointerPressed="Overlay_PointerPressed" PointerMoved="Overlay_PointerMoved"
                        PointerReleased="Overlay_PointerReleased" PointerCanceled="Overlay_PointerReleased" />
                <!-- Editor-only: selection outline and resize handle (never captured). -->
                <Canvas x:Name="AdornerCanvas">
                    <Rectangle x:Name="SelectionBox" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="3" StrokeDashArray="4,3"
                               Visibility="Collapsed" IsHitTestVisible="False" />
                    <Border x:Name="ResizeHandle" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderBrush="White" BorderThickness="3" Visibility="Collapsed"
                            PointerPressed="Resize_PointerPressed" PointerMoved="Resize_PointerMoved"
                            PointerReleased="Resize_PointerReleased" PointerCanceled="Resize_PointerReleased"
                            AutomationProperties.Name="Resize layer" />
                </Canvas>
            </Grid>
        </Viewbox>

        <!-- Vignette -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.75" RadiusY="0.7" GradientOrigin="0.5,0.45">
                    <GradientStop Color="#00000000" Offset="0.6" />
                    <GradientStop Color="#AA000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Screen light drawn inside the window (default mode): bars, frame or ring of light around the video. -->
        <Canvas x:Name="LightLayer" IsHitTestVisible="False" Visibility="Collapsed" SizeChanged="LightLayer_SizeChanged" />

        <!-- Live captions: shown over the preview and burnt into the meeting camera and recordings. -->
        <Border x:Name="CaptionBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,176"
                Background="#D9000000" CornerRadius="12" Padding="18,8" MaxWidth="900" IsHitTestVisible="False">
            <TextBlock x:Name="CaptionText" FontSize="24" FontWeight="SemiBold" Foreground="White" TextAlignment="Center"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <!-- 3-2-1 before recording starts -->
        <TextBlock x:Name="CountdownText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="160" FontWeight="SemiBold" Foreground="White" IsHitTestVisible="False"
                   AutomationProperties.LiveSetting="Assertive" />

        <!-- Empty state -->
        <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <FontIcon Glyph="&#xE714;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="22" HorizontalAlignment="Center" Text="No camera connected" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" HorizontalAlignment="Center"
                       Text="Pick a device in the Camera panel and press Connect." />
            <TextBlock x:Name="EmptyBusy" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
            <Button x:Name="EmptyConnectBtn" Content="Connect camera" Click="EmptyConnect_Click" HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}" CornerRadius="12" Padding="22,9" FontSize="15"
                    AutomationProperties.Name="Connect camera" />
        </StackPanel>

        <!-- ═══ Top capsule ═══ -->
        <!-- Command bar: docked across the top like a native Windows 11 app. -->
        <Border Style="{StaticResource Glass}" CornerRadius="8" MinHeight="48" Margin="12,4,12,0" Padding="8,0,8,0"
                HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid>
            <StackPanel x:Name="CapsuleRow" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- App name lives in the title bar. -->
                <Button x:Name="SnapshotBtn" Style="{StaticResource CapsuleButton}" Click="SnapshotBtn_Click" IsEnabled="False"
                        AutomationProperties.Name="Snapshot" ToolTipService.ToolTip="Save a still image (Ctrl+Shift+S)" AutomationProperties.HelpText="Save a still image (Ctrl+Shift+S)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE722;" FontSize="14" /><TextBlock Text="Snapshot" />
                    </StackPanel>
                </Button>
                <Button x:Name="RecordBtn" Style="{StaticResource CapsuleButton}" Click="RecordBtn_Click" IsEnabled="False"
                        AutomationProperties.Name="Record" ToolTipService.ToolTip="Start or stop recording (Ctrl+R)" AutomationProperties.HelpText="Start or stop recording (Ctrl+R)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon x:Name="RecordIcon" Glyph="&#xE7C8;" FontSize="14" />
                        <TextBlock x:Name="RecordLabel" Text="Record" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="LiveBtn" Style="{StaticResource CapsuleButton}" Click="LiveBtn_Click" IsEnabled="False"
                        AutomationProperties.Name="Go live" ToolTipService.ToolTip="Livestream to YouTube, Twitch, Facebook or any RTMP server" AutomationProperties.HelpText="Livestream to YouTube, Twitch, Facebook or any RTMP server">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE93E;" FontSize="14" />
                        <TextBlock x:Name="LiveLabel" Text="Go live" />
                    </StackPanel>
                </Button>
                <Button x:Name="PauseBtn" Style="{StaticResource CapsuleButton}" Click="PauseBtn_Click" Visibility="Collapsed"
                        AutomationProperties.Name="Pause recording" ToolTipService.ToolTip="Pause or resume recording (Ctrl+Shift+R)" AutomationProperties.HelpText="Pause or resume recording (Ctrl+Shift+R)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" />
                        <TextBlock x:Name="PauseLabel" Text="Pause" />
                    </StackPanel>
                </Button>
                <DropDownButton x:Name="MeetCamBtn" MinHeight="40" CornerRadius="8" Padding="14,0,10,0" Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="Meeting camera" ToolTipService.ToolTip="Use KISSIK as the camera in Zoom, Teams, Meet, Discord or OBS" AutomationProperties.HelpText="Use KISSIK as the camera in Zoom, Teams, Meet, Discord or OBS">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse x:Name="MeetCamDot" AutomationProperties.AccessibilityView="Raw" Width="8" Height="8" Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Meeting camera" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout x:Name="MeetCamFlyout" Placement="Bottom" Opening="MeetCamFlyout_Opening">
                            <StackPanel Width="320" Spacing="10">
                                <TextBlock Text="Meeting camera" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="MeetCamStatus" TextWrapping="Wrap" FontSize="13" />
                                <TextBlock x:Name="MeetCamLive" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <Button Content="Check my setup" Click="MeetingCheck_Click" HorizontalAlignment="Stretch"
                                        ToolTipService.ToolTip="Tests camera, framing, light, microphone and the meeting camera" AutomationProperties.HelpText="Tests camera, framing, light, microphone and the meeting camera" />
                                <Button x:Name="MeetCamInstallBtn" Content="Install the KISSIK camera" Click="MeetCamInstall_Click"
                                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                                <Button x:Name="MeetCamOnBtn" Content="Make sure it's listed" Click="MeetCamOn_Click" HorizontalAlignment="Stretch" />
                                <Button x:Name="MeetCamUninstallBtn" Content="Remove the camera" Click="MeetCamUninstall_Click" HorizontalAlignment="Stretch" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.7"
                                           Text="Everything you see here (effects, light, scenes) is what the meeting sees. When KISSIK is closed, meetings show an KISSIK card instead of a black screen." />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="ShutterBtn" Style="{StaticResource CapsuleButton}" AutomationProperties.Name="Privacy shutter"
                                ToolTipService.ToolTip="Hide yourself from the meeting and recording (Ctrl+Shift+H)" AutomationProperties.HelpText="Hide yourself from the meeting and recording (Ctrl+Shift+H)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon x:Name="ShutterIcon" Glyph="&#xE7B3;" FontSize="14" /><TextBlock x:Name="ShutterText" Text="Visible" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Show me" Tag="Off" Click="Shutter_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B3;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Blur me" Tag="Blur" Click="Shutter_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE727;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Be right back" Tag="Away" Click="Shutter_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE769;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="GuardToggle" Text="Privacy guard: blur me if someone else appears" Click="GuardToggle_Click">
                                <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE83D;" /></ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="LightBtn" Style="{StaticResource CapsuleButton}" Click="LightBtn_Click"
                        AutomationProperties.Name="Screen light" ToolTipService.ToolTip="Use your screen as a soft key light" AutomationProperties.HelpText="Use your screen as a soft key light">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon x:Name="LightBtnIcon" Glyph="&#xEA80;" FontSize="14" /><TextBlock Text="Light" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- Secondary actions sit on the right, like a Windows 11 command bar. -->
            <StackPanel x:Name="CapsuleRight" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <DropDownButton x:Name="ProfileButton" MinHeight="40" CornerRadius="8" Padding="14,0,10,0"
                                Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                AutomationProperties.Name="Output profile" ToolTipService.ToolTip="Output resolution and frame rate" AutomationProperties.HelpText="Output resolution and frame rate">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="ProfileName" Text="Meetings" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run x:Name="ProfilePillTopRun" /><Run Text=" " /><Run x:Name="ProfilePillBottomRun" />
                        </TextBlock>
                        <TextBlock x:Name="ProfilePillTop" Visibility="Collapsed" /><TextBlock x:Name="ProfilePillBottom" Visibility="Collapsed" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ProfileMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="DonateBtn" Click="DonateBtn_Click" Visibility="Collapsed" MinHeight="40" CornerRadius="8" Padding="12,0"
                        Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        AutomationProperties.Name="Support KISSIK" ToolTipService.ToolTip="KISSIK is free and open source. Support it with PayPal or UPI." AutomationProperties.HelpText="KISSIK is free and open source. Support it with PayPal or UPI.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🙏" FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="Support" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <DropDownButton MinHeight="40" Width="44" CornerRadius="8" Padding="0" Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="View options" ToolTipService.ToolTip="View options" AutomationProperties.HelpText="View options">
                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Recordings and snapshots" Click="RecordingsBtn_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B2;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Open the gallery" Click="GalleryBtn_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF0E2;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Name="VerticalToggle" Text="Also record a vertical (9:16) copy" Click="VerticalToggle_Click">
                                <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C4;" /></ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutItem Text="Prompter under the webcam" Click="PrompterBtn_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Name="CaptionsToggle" Text="Live captions" Click="CaptionsToggle_Click">
                                <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xED1E;" /></ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Name="AccurateToggle" Text="Accurate captions (corrects each line a moment later)" Click="AccurateToggle_Click">
                                <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FB;" /></ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="ReplayToggle" Text="Replay buffer (keeps the last 30 seconds)" Click="ReplayToggle_Click">
                                <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SaveReplayItem" Text="Save the last 30 seconds" Click="SaveReplay_Click" IsEnabled="False">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control,Menu" Key="S" /></MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Scan a document…" Click="ScanDocument_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="UpdateItem" Text="Check for updates" Click="UpdateItem_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem Text="View">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE890;" /></MenuFlyoutSubItem.Icon>
                                <RadioMenuFlyoutItem x:Name="ModeSimpleItem" Text="Simple: five big buttons" GroupName="UiMode" Tag="Simple" Click="UiMode_Click" />
                                <RadioMenuFlyoutItem x:Name="ModeStudioItem" Text="Studio: every control" GroupName="UiMode" Tag="Studio" Click="UiMode_Click" />
                                <ToggleMenuFlyoutItem x:Name="LargeControlsToggle" Text="Large controls" Click="LargeControls_Click">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E8;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="LeftPaneToggle" Text="Show or hide the control panel" Click="LeftPaneToggle_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE89F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="RightPaneToggle" Text="Show or hide framing and scenes" Click="RightPaneToggle_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A9;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <ToggleMenuFlyoutItem x:Name="ExposureToggle" Text="Show exposure (red = too bright, blue = too dark)" Click="ExposureToggle_Click">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE706;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem x:Name="SmartMirrorToggle" Text="Mirror my preview only (meetings see the true view)" Click="SmartMirror_Click">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AB;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutSubItem Text="See as a colour-blind viewer">
                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE7B3;" /></MenuFlyoutSubItem.Icon>
                                    <RadioMenuFlyoutItem Text="Normal" GroupName="Cvd" Tag="Off" Click="Cvd_Click" IsChecked="True" />
                                    <RadioMenuFlyoutItem Text="Red-green (deuteranopia, most common)" GroupName="Cvd" Tag="Deuteranopia" Click="Cvd_Click" />
                                    <RadioMenuFlyoutItem Text="Red-green (protanopia)" GroupName="Cvd" Tag="Protanopia" Click="Cvd_Click" />
                                    <RadioMenuFlyoutItem Text="Blue-yellow (tritanopia)" GroupName="Cvd" Tag="Tritanopia" Click="Cvd_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem Text="Scene transition">
                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8AB;" /></MenuFlyoutSubItem.Icon>
                                    <RadioMenuFlyoutItem x:Name="TrFade" Text="Fade" GroupName="Transition" Tag="Fade" Click="Transition_Click" />
                                    <RadioMenuFlyoutItem x:Name="TrSlide" Text="Slide" GroupName="Transition" Tag="Slide" Click="Transition_Click" />
                                    <RadioMenuFlyoutItem x:Name="TrZoom" Text="Zoom" GroupName="Transition" Tag="Zoom" Click="Transition_Click" />
                                    <RadioMenuFlyoutItem x:Name="TrCut" Text="Cut (instant)" GroupName="Transition" Tag="Cut" Click="Transition_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem Text="Theme">
                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutSubItem.Icon>
                                    <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="Same as Windows" GroupName="Theme" Tag="System" Click="Theme_Click" />
                                    <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Light" GroupName="Theme" Tag="Light" Click="Theme_Click" />
                                    <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Dark" GroupName="Theme" Tag="Dark" Click="Theme_Click" />
                                </MenuFlyoutSubItem>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="Settings and help">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Name="CrashReportsToggle" Text="Send crash reports automatically" Click="CrashReportsToggle_Click">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xEBE8;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem x:Name="SponsorToggle" Text="Show sponsored picks" Click="SponsorToggle_Click">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE719;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem x:Name="ControlToggle" Text="Let AI assistants and Stream Deck control KISSIK" Click="ControlToggle_Click">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE99A;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy diagnostics" Click="CopyDiagnostics_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Support KISSIK" Click="DonateBtn_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB51;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Name="SaveWindowPicture" Text="Save a picture of this window" Click="SaveWindowPicture_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE722;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ HUD pills (top-right of the video) ═══ -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,90,272,0" IsHitTestVisible="False">
            <Border x:Name="RecPill" Background="{StaticResource DgRecBrush}" CornerRadius="14" Padding="10,5" Visibility="Collapsed">
                <TextBlock x:Name="RecPillText" AutomationProperties.LiveSetting="Polite" Text="● REC" FontSize="12" FontWeight="SemiBold" Foreground="White" />
            </Border>
            <Border Background="#88000000" CornerRadius="14" Padding="10,5">
                <TextBlock x:Name="HudText" FontSize="12" Foreground="White" Text="No device open" />
            </Border>
        </StackPanel>

        <!-- ═══ Left sheet ═══ -->
        <Border x:Name="LeftPane" Style="{StaticResource Glass}" Width="316" Margin="12,60,0,144"
                HorizontalAlignment="Left" VerticalAlignment="Stretch" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="12" Padding="3">
                    <SelectorBar x:Name="SidebarTabs" SelectionChanged="SidebarTabs_SelectionChanged" HorizontalAlignment="Stretch">
