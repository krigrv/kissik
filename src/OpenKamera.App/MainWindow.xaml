<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OpenKamera_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OpenKamera_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="KISSIK"
    mc:Ignorable="d">

    <!-- Plain Windows window: a standard title bar with icon and name, the app below it. -->

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="18" Height="18" />
                <TextBlock Text="KISSIK" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
