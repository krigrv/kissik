<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OpenKamera_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OpenKamera_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="OpenKamera"
    mc:Ignorable="d">

    <!-- Darkroom Glass: the page (live video) fills the whole window, title bar included. -->
    <Grid Background="Black">
        <Frame x:Name="RootFrame" />
        <!-- Drag region: a strip at the top-left, clear of the floating capsule. Caption buttons are drawn by the system. -->
        <Grid x:Name="AppTitleBar" Height="40" Width="300" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent">
            <TextBlock Text="OpenKamera" FontSize="12" Foreground="#A8F4F5F7" Margin="16,0,0,0" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
